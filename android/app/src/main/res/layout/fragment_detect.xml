<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ========== 选择图片 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/det_step1" />

                <TextView
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/det_step1_hint" />

                <!-- 待检图 -->
                <LinearLayout
                    android:id="@+id/detTargetSlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_slot"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp">

                        <TextView
                            android:id="@+id/detTargetHint"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/det_pick_target"
                            android:textColor="@color/text_faint"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/detTargetPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/det_pick_target"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/detTargetMeta"
                        style="@style/SlotMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="640 × 480 px" />
                </LinearLayout>

                <!-- 原图 + 候选水印 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/detOriginSlot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_slot"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <TextView
                                android:id="@+id/detOriginHint"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:padding="6dp"
                                android:text="@string/det_pick_origin"
                                android:textColor="@color/text_faint"
                                android:textSize="12sp" />

                            <ImageView
                                android:id="@+id/detOriginPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/det_pick_origin"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/detOriginMeta"
                            style="@style/SlotMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="640 × 480 px" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/detCandSlot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_slot"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <TextView
                                android:id="@+id/detCandHint"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:padding="6dp"
                                android:text="@string/det_pick_cand"
                                android:textColor="@color/text_faint"
                                android:textSize="12sp" />

                            <ImageView
                                android:id="@+id/detCandPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/det_pick_cand"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/detCandMeta"
                            style="@style/SlotMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="180 × 84 px" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <include
            android:id="@+id/opts"
            layout="@layout/part_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- ========== 检测 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/det_step2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/det_run" />

                <ProgressBar
                    android:id="@+id/progBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/progText"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    tools:text="处理中 45%　已用 1.2 s"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/resBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/verdictBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/verdictTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="检测到盲水印" />

                        <TextView
                            android:id="@+id/verdictSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingMultiplier="1.3"
                            android:textSize="12sp"
                            tools:text="频谱残差被强制成实值，符合本算法嵌入水印的特征。" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statText"
                        style="@style/StatText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        tools:text="实部/虚部能量比 12.67\n残差实部能量 2.04e+9\n残差虚部能量 1.27e+7" />

                    <LinearLayout
                        android:id="@+id/previewBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/previewImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:adjustViewBounds="true"
                            android:background="@color/slot_bg"
                            android:contentDescription="@string/det_save"
                            android:maxHeight="360dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/det_save" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
