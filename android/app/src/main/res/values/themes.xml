<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BlindWatermark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="CardHint">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="SlotMeta">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="StatText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

</resources>
