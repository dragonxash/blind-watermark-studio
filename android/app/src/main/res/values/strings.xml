<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">盲水印工坊</string>
    <string name="app_subtitle">FFT 频域盲水印 · 合成 / 分离 / 检测</string>

    <string name="tab_encode">合成</string>
    <string name="tab_decode">分离</string>
    <string name="tab_detect">检测</string>

    <!-- ============ 参数 ============ -->
    <string name="opt_title">算法参数</string>
    <string name="opt_hint">三个面板共用。合成与分离时的种子、强度、变换模式必须完全一致，否则解不出水印。</string>
    <string name="opt_seed">种子 seed</string>
    <string name="opt_alpha">强度 alpha</string>
    <string name="opt_alpha_tip">越大越抗压缩，但越容易被看出</string>
    <string name="opt_mode">变换模式</string>
    <string name="opt_backdrop">透明区域合成</string>

    <string name="mode_numpy">兼容原作（可与 Python 互解）</string>
    <string name="mode_channel">高质量（改动更小）</string>
    <string name="mode_note_numpy">兼容原作：复刻 np.fft.fft2 对 (H,W,3) 的默认变换轴（宽度轴 + 通道轴），结果可与 Python 版 bwmforpy3.py 互相解出。检测判据灵敏，但图像改动相对大一些。</string>
    <string name="mode_note_channel">高质量：每个颜色通道独立做空间二维 FFT，图像改动极小（PSNR 通常 55 dB 以上），肉眼完全无感。代价是只有本 App 能解出，Python 原作脚本解不出来。</string>

    <string name="backdrop_white">合成到白底</string>
    <string name="backdrop_black">合成到黑底</string>
    <string name="backdrop_ignore">忽略透明通道</string>

    <!-- ============ 合成 ============ -->
    <string name="enc_step1">① 选择图片</string>
    <string name="enc_step1_hint">左：载体图（会被嵌入水印）　右：水印图。\n水印高度须小于载体图的一半，宽度须小于载体图宽度。</string>
    <string name="enc_pick_img">点击选择载体图</string>
    <string name="enc_pick_wm">点击选择水印图</string>
    <string name="enc_step2">② 合成并保存</string>
    <string name="enc_step2_hint">水印会被打散后叠加到载体图的频域上，肉眼几乎看不出差别。结果一律以 PNG 无损保存。</string>
    <string name="enc_run">开始合成</string>
    <string name="enc_save">保存合成图</string>

    <!-- ============ 分离 ============ -->
    <string name="dec_step1">① 选择图片</string>
    <string name="dec_step1_hint">左：原始载体图（未加过水印的那张）　右：带水印的图。\n两张图必须尺寸完全一致。</string>
    <string name="dec_pick_img">点击选择原始载体图</string>
    <string name="dec_pick_wm">点击选择含水印图</string>
    <string name="dec_step2">② 分离水印</string>
    <string name="dec_step2_hint">利用两张图的频谱差分还原水印。噪点与对角双影来自算法本身，可用「增强显示」把轮廓拉出来。</string>
    <string name="dec_run">开始分离</string>
    <string name="dec_save">保存水印图</string>
    <string name="dec_enhance">增强显示</string>
    <string name="dec_original">查看原始</string>

    <!-- ============ 检测 ============ -->
    <string name="det_step1">① 选择图片</string>
    <string name="det_step1_hint">给出原图可做精确检测（推荐）；不给则退化为频谱启发式盲检，结论仅供参考。</string>
    <string name="det_pick_target">点击选择待检图（必选）</string>
    <string name="det_pick_origin">可选：原图（精确检测）</string>
    <string name="det_pick_cand">可选：候选水印（核对）</string>
    <string name="det_step2">② 开始检测</string>
    <string name="det_run">开始检测</string>
    <string name="det_save">保存还原的水印</string>

